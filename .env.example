# ==========================================================
# Variables de Entorno · La Libertad Avanza Almirante Brown
# ==========================================================

# Puerto expuesto en el host (por defecto 3000 o 80 en la VM de Oracle)
PORT_BINDING=3000

# Credenciales de PostgreSQL
POSTGRES_USER=lla_user
POSTGRES_PASSWORD=lla_password_segura_2026
POSTGRES_DB=llabrown

# URL de conexión (usada internamente por Next.js en Docker)
DATABASE_URL=postgresql://lla_user:lla_password_segura_2026@db:5432/llabrown

# Entorno de ejecución
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
